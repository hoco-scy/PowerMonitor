<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════ 颜色定义 ═══════════════════ -->
    <Color x:Key="BackgroundColor">#FF0D1117</Color>
    <Color x:Key="SurfaceColor">#FF161B22</Color>
    <Color x:Key="SurfaceLightColor">#FF21262D</Color>
    <Color x:Key="BorderColor">#FF30363D</Color>

    <Color x:Key="AccentColor">#FF00D4AA</Color>
    <Color x:Key="AccentDimColor">#8000D4AA</Color>
    <Color x:Key="AccentFaintColor">#3300D4AA</Color>

    <Color x:Key="TextPrimaryColor">#FFE6EDF3</Color>
    <Color x:Key="TextSecondaryColor">#FF8B949E</Color>
    <Color x:Key="TextDimColor">#FF484F58</Color>

    <Color x:Key="DangerColor">#FFFF6B6B</Color>
    <Color x:Key="WarningColor">#FFFFA500</Color>
    <Color x:Key="SuccessColor">#FF00D4AA</Color>

    <Color x:Key="GpuColor">#FF7C4DFF</Color>
    <Color x:Key="CpuColor">#FF00D4AA</Color>
    <Color x:Key="SystemColor">#FF58A6FF</Color>

    <!-- ═══════════════════ 画刷 ═══════════════════ -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLightColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="AccentFaintBrush" Color="{StaticResource AccentFaintColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />

    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <SolidColorBrush x:Key="GpuBrush" Color="{StaticResource GpuColor}" />
    <SolidColorBrush x:Key="CpuBrush" Color="{StaticResource CpuColor}" />
    <SolidColorBrush x:Key="SystemBrush" Color="{StaticResource SystemColor}" />

    <!-- ═══════════════════ 字体 ═══════════════════ -->
    <FontFamily x:Key="MonoFont">Consolas, Courier New</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI, Microsoft YaHei</FontFamily>

    <!-- ═══════════════════ 发光效果 ═══════════════════ -->
    <DropShadowEffect x:Key="AccentGlow" Color="{StaticResource AccentColor}"
                      BlurRadius="12" ShadowDepth="0" Opacity="0.5" />
    <DropShadowEffect x:Key="AccentGlowSubtle" Color="{StaticResource AccentColor}"
                      BlurRadius="6" ShadowDepth="0" Opacity="0.3" />
    <DropShadowEffect x:Key="GpuGlow" Color="{StaticResource GpuColor}"
                      BlurRadius="12" ShadowDepth="0" Opacity="0.5" />

    <!-- ═══════════════════ 样式 ═══════════════════ -->

    <!-- 大号功耗数值 -->
    <Style x:Key="PowerValueText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- 单位标签 -->
    <Style x:Key="UnitLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="4,0,0,4" />
    </Style>

    <!-- 区域标签 (CPU/GPU/SYSTEM) -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- 百分比数值 -->
    <Style x:Key="PercentValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- 区域边框 -->
    <Style x:Key="SectionBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- 图标按钮 -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            x:Name="border">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceLightBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 进程列表项 -->
    <Style x:Key="ProcessNameText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ProcessPowerText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

</ResourceDictionary>
