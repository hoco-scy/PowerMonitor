<Window x:Class="PowerMonitor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PowerMonitor.UI.Controls"
        xmlns:vm="clr-namespace:PowerMonitor.UI.ViewModels"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip"
        Width="320" Height="580" MinWidth="280" MinHeight="300"
        Loaded="OnLoaded">

    <Border CornerRadius="12"
            Background="#E60D1117"
            BorderBrush="#3300D4AA"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0">
        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar (drag handle) -->
            <Grid Grid.Row="0" Margin="12,8,8,4" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="P O W E R   M O N I T O R"
                           FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                           Foreground="#FF8B949E"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}"
                            Click="OnLockClick"
                            ToolTip="Lock/Unlock Position">
                        <Path x:Name="LockIcon" Stroke="#FF484F58"
                              StrokeThickness="1.5" Width="12" Height="12"
                              Data="{StaticResource LockIconData}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Click="OnMinimizeClick" ToolTip="Minimize to Tray">
                        <Path Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.5"
                              Width="10" Height="10" Data="M0,5 L10,5" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Click="OnCloseClick" ToolTip="Close to Tray">
                        <Path Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.5"
                              Width="10" Height="10" Data="M0,0 L10,10 M10,0 L0,10" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- CPU -->
            <Border Grid.Row="1" Style="{StaticResource SectionBorder}" Margin="8,2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <TextBlock Text="CPU" Style="{StaticResource SectionLabel}"
                                   DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding CpuTempText}"
                                   FontFamily="Consolas" FontSize="10"
                                   Foreground="#FFFFA500"
                                   HorizontalAlignment="Right" />
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding CpuPowerText}" Style="{StaticResource PowerValueText}" />
                        <TextBlock Text="W" Style="{StaticResource UnitLabel}" />
                        <TextBlock Text="{Binding CpuUsageText}" Style="{StaticResource PercentValue}"
                                   VerticalAlignment="Bottom" Margin="16,0,0,6" />
                    </StackPanel>

                    <controls:MiniGraph Grid.Row="2" Height="35" Margin="0,4,0,0"
                                        History="{Binding CpuPowerHistory}"
                                        MaxValue="{Binding CpuHistoryMax}"
                                        GraphColor="#FF00D4AA" />
                </Grid>
            </Border>

            <!-- GPU (multi-GPU via ItemsControl) -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding GpuSections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:GpuDisplayItem">
                        <Border Style="{StaticResource SectionBorder}" Margin="8,2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header: GPU Hardware Name [dGPU/iGPU] + Temp -->
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Style="{StaticResource SectionLabel}"
                                                   MaxWidth="200"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding GpuLabel, StringFormat=' [{0}]'}"
                                                   FontFamily="Consolas" FontSize="9"
                                                   Foreground="#FF484F58"
                                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding TempText}"
                                               FontFamily="Consolas" FontSize="10"
                                               Foreground="#FFFFA500"
                                               HorizontalAlignment="Right" />
                                </DockPanel>

                                <!-- Power, usage, mem -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding PowerText}" Style="{StaticResource PowerValueText}">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding AccentColor}" />
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock Text="W" Style="{StaticResource UnitLabel}" />
                                    <TextBlock Text="{Binding UsageText}" Style="{StaticResource PercentValue}"
                                               VerticalAlignment="Bottom" Margin="16,0,0,6" />
                                    <TextBlock Text="{Binding MemText}"
                                               FontFamily="Consolas" FontSize="9"
                                               Foreground="#FF484F58"
                                               VerticalAlignment="Bottom" Margin="8,0,0,7" />
                                </StackPanel>

                                <!-- Mini graph -->
                                <controls:MiniGraph Grid.Row="2" Height="28" Margin="0,4,0,0"
                                                    History="{Binding PowerHistory}"
                                                    MaxValue="{Binding HistoryMax}"
                                                    GraphColor="{Binding AccentColor}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- System total + gauge -->
            <Border Grid.Row="3" Style="{StaticResource SectionBorder}" Margin="8,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:PowerGauge Width="90" Height="90"
                                         Value="{Binding SystemTotalPower}"
                                         Maximum="500" Label="TOTAL" Unit="W" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="SYSTEM" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SystemTotalText}" Style="{StaticResource PowerValueText}"
                                       FontSize="22">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="#FF58A6FF" />
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Text="W" Style="{StaticResource UnitLabel}" Margin="4,0,0,2" />
                        </StackPanel>
                        <controls:MiniGraph Height="25" Margin="0,4,0,0"
                                            History="{Binding SystemPowerHistory}"
                                            MaxValue="500"
                                            GraphColor="#FF58A6FF" />
                            <TextBlock Text="MODULES" Style="{StaticResource SectionLabel}" Margin="0,6,0,2" />
                            <controls:PowerModuleList Modules="{Binding ModulePowers}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Process list -->
            <Border Grid.Row="4" Style="{StaticResource SectionBorder}" Margin="8,2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="TOP PROCESSES" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />

                    <Grid Grid.Row="1">
                        <controls:ProcessList x:Name="ProcessListControl"
                                              Processes="{Binding TopProcesses}"
                                              Visibility="{Binding IsProcessSampling, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                        <TextBlock Text="{Binding ProcessStatusText}"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="#FF484F58"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsProcessSampling, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="5" Margin="12,4,12,8">
                <DockPanel>
                    <TextBlock Text="{Binding UptimeText}"
                               FontFamily="Consolas" FontSize="9"
                               Foreground="#FF484F58"
                               DockPanel.Dock="Right" />
                    <TextBlock Text="{Binding FpsText}"
                               FontFamily="Consolas" FontSize="9"
                               Foreground="#FF484F58" />
                </DockPanel>
            </Border>
        </Grid>
        </ScrollViewer>
    </Border>
</Window>
