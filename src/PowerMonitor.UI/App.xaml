<Application x:Class="PowerMonitor.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             StartupUri="MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 锁定图标颜色转换器 -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- 锁图标数据 (小锁形状) -->
            <Geometry x:Key="LockIconData">M5,2 L5,0 C5,-1.5 7,-2 8,-2 C9,-2 11,-1.5 11,0 L11,2 M3,2 L13,2 L13,10 L3,10 Z M6,5 L6,7 L10,7 L10,5 Z</Geometry>

            <!-- 锁定状态颜色转换 -->
            <Style x:Key="LockColorConverter" TargetType="SolidColorBrush">
                <Setter Property="Color" Value="#FF484F58" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                        <Setter Property="Color" Value="#FF00D4AA" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
